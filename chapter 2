function run(){const d=cur.d,g=cur.groups,names=Object.keys(g),arrs=names.map(n=>g[n]),al=cur.alpha,des=d.design,alt=cur.alt,o=$('out');
 if((des==='independent'&&arrs.length<2)||arrs.some(a=>a.length<2)||(des==='paired'&&arrs[0].length!==arrs[1].length)){o.innerHTML='<div class="card">Check the data: each group needs at least two values, and paired data needs equal group sizes.</div>';return}
 const x1=des==='paired'?arrs[0].map((v,i)=>v-arrs[1][i]):arrs[0],res=des==='independent'?arrs.flatMap(a=>a.map(v=>v-mean(a))):x1.map(v=>v-mean(x1));
 const S=sw(res),L=des==='independent'?bp(arrs):null,D=dw(res,des==='independent'?arrs:[x1]),normOK=S?S.p>=al:true,varOK=L?L.p>=al:true,indOK=D?D.p>=al:true,sg=parseFloat(cur.sg)||0,mu=+cur.mu,A=AS[alt];
 const H0=des==='one'?'μ = '+mu:des==='paired'?'μ_D = 0':'μ₁ = μ₂',H1=des==='one'?'μ '+A+' '+mu:des==='paired'?'μ_D '+A+' 0':'μ₁ '+A+' μ₂';
 const rec=des==='one'?(sg>0?'one_z':'one_t'):des==='paired'?'paired_t':(varOK?'pooled':'welch'),kind=cur.test==='recommended'?rec:cur.test,R=runTest(kind,{arrs,x1,alt,al,mu,sg,des});
 const recTxt={one_t:'One-sample t-test (σ unknown, so t rather than z).',one_z:'One-sample z-test (population σ is known).',paired_t:'Paired t-test on the within-pair differences.',pooled:'Pooled two-sample t-test (the variances look equal).',welch:'Welch two-sample t-test (the variances look different).'}[rec]+(normOK?'':' Normality is doubtful, so consider the rank test from the dropdown.');
 const rows=names.map((n,i)=>`<tr><td>${n}</td><td>${arrs[i].length}</td><td>${f4(mean(arrs[i]))}</td><td>${f4(sd(arrs[i]))}</td></tr>`).join('')+(des==='paired'?`<tr><td>Difference (${names[0]} − ${names[1]})</td><td>${x1.length}</td><td>${f4(mean(x1))}</td><td>${f4(sd(x1))}</td></tr>`:'');
 const alsel=`<select id="alt">${[['two.sided','Two-sided (≠)'],['greater','Greater than (>)'],['less','Less than (<)']].map(a=>`<option value="${a[0]}"${a[0]===alt?' selected':''}>${a[1]}</option>`).join('')}</select>`;
 let h=`<div class="card"><h2><span>1</span>Hypotheses</h2><p class="m">H₀: ${H0}<br>H₁: ${H1}</p><p>Alternative: ${alsel}${des==='one'?` &nbsp; Reference mean μ₀: <input id="mu" type="number" step="any" value="${mu}" style="width:100px"> &nbsp; Known σ (optional): <input id="sg" type="number" step="any" value="${cur.sg}" style="width:90px">`:''}</p>${des==='paired'?'<p class="note">μ_D is the mean of (first − second) within each pair.</p>':''}</div>
 <div class="card"><h2><span>2</span>Sensitivity (significance level α)</h2><input type="range" id="al" min="0.01" max="0.10" step="0.01" value="${al}" style="width:260px"> <b class="m">α = ${al.toFixed(2)}</b><p class="note">Changing α recomputes every step below.</p></div>
 <div class="card"><h2><span>3</span>Data summary</h2><table><tr><th>Group</th><th>n</th><th>Mean</th><th>SD</th></tr>${rows}</table></div>
 <div class="card"><h2><span>4</span>Test and results</h2><p><b>Recommendation:</b> ${recTxt} <span class="note">Assumption checks are in step 6.</span></p>
 <p>Choose a test: <select id="tst">${TESTS.map(t=>`<option value="${t[0]}"${t[0]===cur.test?' selected':''}>${t[1]}</option>`).join('')}</select></p>`;
 let rej=false;
 if(R.err)h+=`<div class="dec">${R.err}</div></div>`;
 else{rej=R.p<al;h+=`<p><b>${R.name}</b></p><div class="g3"><div>Statistic<br><b class="m">${R.dist==='z'?'z':'t'} = ${f4(R.stat)}</b></div><div>p-value<br><b class="m">${fp(R.p)}</b></div><div>Critical value<br><b class="m">${alt==='two.sided'?'±':''}${f4(Math.abs(R.crit))}</b></div></div>${R.ci?`<p>Estimate = ${f4(R.est)}; ${Math.round((1-al)*100)}% confidence interval: (${f4(R.ci[0])}, ${f4(R.ci[1])})${R.dist==='t'?', df = '+R.df.toFixed(2):''}</p>`:''}<div id="p4"></div></div>`}
 h+=R.err?`<div class="card"><h2><span>5</span>Decision</h2><p>No decision can be made until a valid test is selected.</p></div>`:`<div class="card"><h2><span>5</span>Decision</h2><div class="dec ${rej?'':'n'}"><b>${rej?'Reject H₀':'Fail to reject H₀'}</b> at α = ${al.toFixed(2)} (p = ${fp(R.p)} ${rej?'<':'≥'} ${al.toFixed(2)}). ${rej?'There is evidence for H₁: '+H1+'.':'There is not enough evidence for H₁.'}</div></div>`;
 h+=`<div class="card"><h2><span>6</span>Assumption checks</h2>${des==='independent'?'<div class="g"><div id="p1"></div><div id="p2"></div></div><div id="p3"></div>':'<div class="g"><div id="p2"></div><div id="p3"></div></div>'}
 <p><b>Normality (Shapiro–Wilk on ${des==='paired'?'the paired differences':'residuals'}):</b> ${S?`W = ${S.W.toFixed(4)}, p = ${fp(S.p)} <span class="tag ${normOK?'ok':'bad'}">${normOK?'normality not rejected':'normality rejected'}</span>`:'needs 4 to 2000 values'}<br>
 <b>Equal variances (Breusch–Pagan, studentized):</b> ${L?`LM = ${L.LM.toFixed(3)}, df = ${L.df}, p = ${fp(L.p)} <span class="tag ${varOK?'ok':'bad'}">${varOK?'variances similar':'variances differ'}</span>`:'not applicable (one set of values)'}<br>
 <b>Independence (Durbin–Watson):</b> ${D?`d = ${D.d.toFixed(3)}, p = ${fp(D.p)} <span class="tag ${indOK?'ok':'bad'}">${indOK?'no autocorrelation detected':'autocorrelation detected'}</span>`:'not computable'}</p>
 <p class="note">Durbin–Watson is only meaningful when the rows are listed in the order the runs were performed.</p></div>`;
 o.innerHTML=h;
 $('alt').onchange=e=>{cur.alt=e.target.value;run()};$('tst').onchange=e=>{cur.test=e.target.value;run()};$('al').oninput=e=>{cur.alpha=+e.target.value;run()};
 if($('mu')){$('mu').onchange=e=>{cur.mu=e.target.value;run()};$('sg').onchange=e=>{cur.sg=e.target.value;run()}}
 if(!R.err)region('p4',R,alt);
 if(des==='independent'){const fit=arrs.flatMap(a=>a.map(()=>mean(a)));draw('p1',[{x:fit,y:res,mode:'markers',marker:{color:'#147d92'}},{x:[Math.min(...fit),Math.max(...fit)],y:[0,0],mode:'lines',line:{color:'#d97706',dash:'dash'}}],lay('Residuals vs fitted','fitted value','residual'))}
 const sr=[...res].sort((a,b)=>a-b),th=sr.map((_,i)=>qn((i+.5)/sr.length)),s2=sd(res);
 draw('p2',[{x:th,y:sr,mode:'markers',marker:{color:'#147d92'}},{x:[th[0],th[th.length-1]],y:[th[0]*s2,th[th.length-1]*s2],mode:'lines',line:{color:'#d97706'}}],lay('Normal Q–Q plot','theoretical quantile','residual'));
 const l3=lay('Residuals vs run order','observation order','residual');l3.height=240;draw('p3',[{x:res.map((_,i)=>i+1),y:res,mode:'markers',marker:{color:'#147d92'}}],l3)}
init();
</script></body></html>
